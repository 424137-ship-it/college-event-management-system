# ==========================================
# HarshaX Django Backend Environment Variables
# ==========================================

# 1. Django Security Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.onrender.com,.vercel.app

# 2. Database (Option A: Cloud Database URL like Railway/Aiven/Render)
# DATABASE_URL=mysql://user:password@host:port/dbname

# 2. Database (Option B: Individual Cloud MySQL Credentials)
DB_NAME=campusx_db
DB_USER=root
DB_PASSWORD=your_cloud_mysql_password
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306

# 3. CORS & CSRF (Allow your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-harshax.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-harshax.vercel.app
