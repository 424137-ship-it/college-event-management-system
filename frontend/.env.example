# HarshaX Frontend Environment Variables
# In Vercel Project Settings > Environment Variables, set:

# The full URL to your Django REST API (must end in /api or match your backend route)
VITE_API_URL=https://your-backend-domain.com/api

# The base URL of your backend (without /api) for serving media files & images
VITE_BACKEND_URL=https://your-backend-domain.com
